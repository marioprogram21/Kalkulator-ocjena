{
    "manifest_version": 3,
    "name": "Kalkulator App",
    "version": "1.0.0",
    "description": "A simple calculator application",
    "permissions": [],
    "action": {
        "default_title": "Kalkulator",
        "default_icon": "images/icon.png",
        "default_popup": "popup.html"
    },
    "icons": {
        "16": "images/icon-16.png",
        "48": "images/icon-48.png",
        "128": "images/icon-128.png"
    }
}{
{
  "name": "Kalkulator ocjena",
  "short_name": "Kalkulator",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#121212",
  "theme_color": "#ff9900",
  "icons": [
    {
      "src": "calculator-icon.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "calculator-icon.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}