{
    "manifest_version": 3,
    "name": "My Extension",
    "version": "1.0",
    "description": "A brief description of what this extension does",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Click to open"
    }
}{
  "name": "Kalkulator ocjena",
  "short_name": "Kalkulator",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#121212",
  "theme_color": "#ff9900",
  "icons": [
    {
      "src": "calculator-icon.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "calculator-icon.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}